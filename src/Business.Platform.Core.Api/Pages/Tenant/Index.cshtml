@page "/app"
@model Business.Platform.Core.Api.Pages.Tenant.IndexModel
@{ ViewData["Title"]="Sua empresa"; var manager=Model.Context?.Role is "Owner" or "Admin"; }
<section class="heading"><div><p class="eyebrow">CONTEXTO VALIDADO</p><h1>@(Model.Context?.OrganizationName ?? "Preparar meu acesso")</h1><p>@(Model.Context?.Role ?? Model.State)</p></div>
<form method="post" action="/account/logout"><button type="submit">Sair</button>@Html.AntiForgeryToken()</form></section>
<div asp-validation-summary="All" role="alert" class="error"></div>
@if(Model.Notice is not null){<p role="status" class="notice">@Model.Notice</p>}
@if(Model.IssuedCode is not null){<section class="notice"><h2>Código mostrado uma única vez</h2><p><code>@Model.IssuedCode</code></p><p>Não é recuperável após sair desta resposta.</p></section>}
@if(Model.Reference is not null){<section class="notice"><h2>Referência para meu convite</h2><p>ID: @Model.Reference.UserId</p><p><code>@Model.Reference.Reference</code></p><p>Válida até @Model.Reference.ExpiresAt.ToString("u")</p></section>}
@if(Model.Context is not null){
<nav aria-label="Jornadas"><a href="/app?section=records">Registros</a>@if(manager){<a href="/app?section=members">Membros</a><a href="/app?section=invitations">Convites</a>}</nav>
<section class="card"><h2>Sessão</h2><p>A inatividade expira em 30 minutos; continuar não ultrapassa o limite absoluto de 24 horas.</p><form method="post" action="/account/session/continue">@Html.AntiForgeryToken()<button>Continuar sessão</button></form></section>
@if(Model.Section=="records"){
<section class="card"><h2>Registros da empresa</h2><form method="get"><input type="hidden" name="section" value="records" /><label for="limit">Itens por página</label><input id="limit" name="limit" type="number" min="1" max="100" value="@Model.Limit" /><button>Consultar</button></form>
@if(Model.Records is { } records){@if(records.Items.Length==0){<p>Nenhum registro nesta página.</p>}<ul class="rows">@foreach(var item in records.Items){<li><a href="/app?section=records&amp;item=@item.Id">@item.Title</a></li>}</ul>
<nav aria-label="Paginação">@if(Model.Offset>0){<a href="/app?limit=@Model.Limit&amp;offset=@Math.Max(0,Model.Offset-Model.Limit)">Anterior</a>}@if(records.HasMore && Model.Offset+Model.Limit<=10000){<a href="/app?limit=@Model.Limit&amp;offset=@(Model.Offset+Model.Limit)">Próxima</a>}</nav>}</section>
@if(Model.Selected is { } selected){<section class="card"><h2>@selected.Title</h2><p>Registro @selected.Id</p></section>}
@if(manager){<section class="card"><h2>@(Model.Id==Guid.Empty?"Criar registro":"Atualizar registro")</h2><form method="post" asp-page-handler="@(Model.Id==Guid.Empty?"Create":"Update")"><input asp-for="Id" type="hidden" /><input asp-for="Key" type="hidden" /><input asp-for="Version" type="hidden" /><label asp-for="Title">Título</label><input asp-for="Title" required maxlength="200" /><p>De 1 a 200 caracteres. Alterações concorrentes exigem recarregar e revisar.</p><button>Salvar</button></form><a href="/app">Recarregar lista</a></section>}
}
@if(Model.Section=="members"){
<section class="card"><h2>Membros</h2>@if(Model.Members is { } members){<ul class="rows">@foreach(var member in members.Items){<li><a href="/app?section=members&amp;item=@member.MembershipId">@member.MembershipId</a><span>@member.Role · @member.Status</span></li>}</ul><nav>@if(Model.Offset>0){<a href="/app?section=members&amp;offset=@Math.Max(0,Model.Offset-Model.Limit)">Anterior</a>}@if(members.HasMore && Model.Offset+Model.Limit<=10000){<a href="/app?section=members&amp;offset=@(Model.Offset+Model.Limit)">Próxima</a>}</nav>}</section>
@if(Model.SelectedMember is { } target){<section class="card"><h2>Membership @target.MembershipId</h2><p>@target.Role · @target.Status</p>
@foreach(var action in new[]{MembershipAction.Promote,MembershipAction.Demote,MembershipAction.Revoke}){if(TenantMembershipPolicy.Allows(Model.Context,target,action)){<form method="post" asp-page-handler="Membership"><input type="hidden" name="Id" value="@target.MembershipId" /><input type="hidden" name="Version" value="@MembershipVersion.Encode(target)" /><input type="hidden" name="action" value="@action" /><button>@action</button></form>}}</section>}
}
@if(Model.Section=="invitations" && manager){
<section class="card"><h2>Convites</h2>@if(Model.Invitations is { } invitations){@if(invitations.Items.Count==0){<p>Nenhum convite nesta página.</p>}<ul class="rows">@foreach(var item in invitations.Items){<li><a href="/app?section=invitations&amp;item=@item.InvitationId">@item.InvitationId</a><span>@item.State · @item.ExpiresAtUtc.ToString("u")</span></li>}</ul>@if(invitations.NextCursor is not null){<a href="/app?section=invitations&amp;cursor=@Uri.EscapeDataString(invitations.NextCursor)">Próxima</a>}}</section>
<section class="card"><h2>Emitir convite Member</h2><form method="post" asp-page-handler="Issue"><input asp-for="Key" type="hidden" /><label asp-for="Recipient">ID do destinatário</label><input asp-for="Recipient" required /><label for="reference">Referência do destinatário</label><input id="reference" name="RecipientReference" type="password" autocomplete="off" required /><button>Emitir convite</button></form></section>
}
}else{<p>Sem contexto empresarial disponível. A identidade nunca vinculada pode preparar ou aceitar seu convite.</p><form method="post" asp-page-handler="Reference"><button>Gerar minha referência</button></form>}
@if(Model.SelectedInvitation is { } invitation){<section class="card"><h2>Convite @invitation.InvitationId</h2><p>@invitation.OrganizationName · @invitation.State · @invitation.Role</p><p>Validade: @invitation.ExpiresAtUtc.ToString("u")</p>
@if(manager && invitation.State is "Pending" or "Expired"){@foreach(var replace in new[]{false,true}){if(replace || invitation.State=="Pending"){<form method="post" asp-page-handler="ChangeInvitation"><input name="Id" type="hidden" value="@invitation.InvitationId" /><input name="Version" type="hidden" value="@InvitationVersion.Encode(invitation)" /><input name="Key" type="hidden" value="@Guid.NewGuid()" /><input name="replace" type="hidden" value="@replace.ToString().ToLowerInvariant()" /><button>@(replace?"Substituir convite":"Cancelar convite")</button></form>}}}</section>}
<section class="card"><h2>Conferir ou aceitar meu convite</h2><p>O código é enviado somente no formulário. A prévia não aceita o convite.</p><form method="post" asp-page-handler="Recipient"><label for="invitation">ID do convite</label><input id="invitation" name="Id" value="@(Model.SelectedInvitation?.InvitationId.ToString()??"")" required /><label for="code">Código recebido</label><input id="code" name="Code" type="password" autocomplete="off" required /><input name="Version" type="hidden" value="@(Model.SelectedInvitation is null?"":InvitationVersion.Encode(Model.SelectedInvitation))" /><button name="accept" value="false">Conferir prévia</button>@if(Model.SelectedInvitation is not null){<button name="accept" value="true">Confirmar aceite</button>}</form></section>
